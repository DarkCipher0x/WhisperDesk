<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WhisperDesk.Addons</AssemblyName>
    <RootNamespace>WhisperDesk.Addons</RootNamespace>
    <Product>WhisperDesk Add-on SDK</Product>
    <Description>Contract for WhisperDesk add-ons: receive live and file transcript events.</Description>
    <Authors>darkcipher0x</Authors>
    <Company>darkcipher0x</Company>
    <Copyright>Copyright © 2026 darkcipher0x</Copyright>
    <Version>1.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- No debug info or local build paths in the shipped DLL -->
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>

</Project>

<Window x:Class="WhisperDesk.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhisperDesk"
        Title="Player — WhisperDesk" Height="760" Width="1060" MinHeight="460" MinWidth="720"
        WindowStartupLocation="CenterOwner" Icon="Assets/app.ico"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        SourceInitialized="OnSourceInitialized" KeyDown="OnKeyDown">
    <Window.Resources>
        <!-- Read-only line: time · ▶ · speaker · text · edited tag -->
        <DataTemplate x:Key="PlayerLine">
            <Grid Margin="2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <Button Grid.Column="1" Style="{StaticResource PlayToggle}" Margin="0,0,6,0" Height="22" VerticalAlignment="Top"
                        Tag="{Binding}" Click="OnPlayLine"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,8,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding Speaker.Color}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Speaker.Tag, StringFormat={}{0}:}" FontWeight="Bold" Foreground="{Binding Speaker.Color}"/>
                </StackPanel>
                <DockPanel Grid.Column="3" Margin="0,2,0,0">
                    <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,0" CornerRadius="2" BorderThickness="1" VerticalAlignment="Top"
                            BorderBrush="{DynamicResource Accent}" ToolTip="{Binding EditSummary}" Cursor="Help">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEdited}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="✎ edited" FontSize="10.5" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Accent}"/>
                    </Border>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                </DockPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header + transport -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="ImportButton" Content="+ Add to my library" Click="OnImport" Visibility="Collapsed"/>
                        <Button Content="⧉ Feed" Click="OnFeed" ToolTip="Pop out a chat-style feed that shows each line as it plays (full screen, snap, second monitor)"/>
                        <Button Content="Summary…" Click="OnSummary"/>
                        <Button x:Name="ShareButton" Content="Share…" Margin="0" Click="OnShare"/>
                    </StackPanel>
                    <TextBlock Text="darkcipher0x@whisperdesk:~$ play" Foreground="{DynamicResource Brand}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                </DockPanel>
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource HeaderFg}" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MetaText" Foreground="#7FA9A6" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PrevButton" Content="⏮" MinWidth="0" Width="38" Margin="0,0,6,0" Click="OnPrevLine"
                                ToolTip="Back to the start of this line, or the previous line (Ctrl+←)"/>
                        <Button x:Name="PlayPause" Content="▶  Play" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="0,0,6,0" Click="OnPlayPause"
                                ToolTip="Play / pause (Space)"/>
                        <Button x:Name="NextButton" Content="⏭" MinWidth="0" Width="38" Margin="0,0,6,0" Click="OnNextLine"
                                ToolTip="Skip to the next line (Ctrl+→)"/>
                        <Button x:Name="StopButton" Content="■" MinWidth="0" Width="38" Margin="0" Click="OnStop"
                                ToolTip="Stop and go back to the start of the current line (Esc)"/>
                    </StackPanel>
                    <Slider Grid.Column="1" x:Name="Seek" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="10,0"
                            IsMoveToPointEnabled="True" PreviewMouseDown="OnSeekStart" PreviewMouseUp="OnSeekEnd"/>
                    <TextBlock Grid.Column="2" x:Name="TimeText" Text="00:00 / 00:00" Foreground="{DynamicResource HeaderFg}"
                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <CheckBox Grid.Column="3" x:Name="FollowBox" Content="Follow along" IsChecked="True" Foreground="{DynamicResource HeaderFg}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="NoAudioText" Visibility="Collapsed" Margin="0,8,0,0" Foreground="#E8A33D" FontSize="12"
                           Text="This session has no audio (saved as transcript only) — you can still read it."/>
            </StackPanel>
        </Border>

        <!-- Speakers + notes -->
        <StackPanel DockPanel.Dock="Top" Margin="18,12,18,6">
            <ItemsControl x:Name="SpeakerChips">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="2" Padding="9,4" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Tag}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TalkTime, StringFormat={}  ·  {0:mm\\:ss}}" Foreground="{DynamicResource Muted}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="NotesBox" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="2" Padding="10,6">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- View switch -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,0,18,8">
            <ToggleButton x:Name="TranscriptViewButton" Content="☰  Transcript" IsChecked="True" Padding="12,4" Margin="0,0,6,0" Click="OnTranscriptView"/>
            <ToggleButton x:Name="ForensicsViewButton" Content="∿  Forensics" Padding="12,4" Click="OnForensicsView"
                          ToolTip="Waveform, spectrogram, pitch and loudness; select any stretch to measure it or identify the speaker. Every step is logged in a tamper-evident audit trail."/>
        </StackPanel>

        <Grid>
            <ListBox x:Name="Lines" Margin="18,0,18,16" ItemTemplate="{StaticResource PlayerLine}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                     MouseDoubleClick="OnLineDoubleClick"/>

            <!-- Forensics view -->
            <Grid x:Name="ForensicsPanel" Visibility="Collapsed" Margin="18,0,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="＋" MinWidth="0" Padding="9,2" Click="OnZoomIn" ToolTip="Zoom in (mouse wheel)"/>
                        <Button Content="－" MinWidth="0" Padding="9,2" Click="OnZoomOut" ToolTip="Zoom out (mouse wheel)"/>
                        <Button Content="Fit" MinWidth="0" Padding="9,2" Click="OnZoomFit" ToolTip="Show the whole recording"/>
                        <Button Content="⇔ Selection" MinWidth="0" Padding="9,2" Click="OnZoomSelection" ToolTip="Zoom to the selection"/>
                        <Button x:Name="PlaySelButton" Content="▶ Selection" MinWidth="0" Padding="9,2" Click="OnPlaySelection" ToolTip="Play just the selected stretch"/>
                        <CheckBox x:Name="LoopBox" Content="Loop" VerticalAlignment="Center" Margin="4,0,12,0"/>
                        <CheckBox x:Name="ScopeFollowBox" Content="Follow" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Click="OnScopeFollow"/>
                        <TextBlock Text="Range" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/>
                        <ComboBox x:Name="RangeBox" Width="80" SelectionChanged="OnRangeChanged" ToolTip="Spectrogram dynamic range">
                            <ComboBoxItem Content="60 dB" Tag="60"/>
                            <ComboBoxItem Content="80 dB" Tag="80" IsSelected="True"/>
                            <ComboBoxItem Content="100 dB" Tag="100"/>
                        </ComboBox>
                        <ComboBox x:Name="FreqBox" Width="84" Margin="6,0,0,0" SelectionChanged="OnRangeChanged" ToolTip="Spectrogram top frequency">
                            <ComboBoxItem Content="0–4 kHz" Tag="4000"/>
                            <ComboBoxItem Content="0–8 kHz" Tag="8000" IsSelected="True"/>
                        </ComboBox>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="ScopeHint" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"
                               Text="Wheel: zoom · Shift+wheel: pan · drag: select · click: jump there · drag the bottom strip: move around · hover for time/frequency"/>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <local:AudioScope x:Name="Scope"/>
                    </Border>
                </DockPanel>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="SELECTION"/>
                        <TextBlock x:Name="SelText" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="0,0,0,6"
                                   Text="Drag across the waveform or spectrogram to select."/>
                        <WrapPanel Margin="0,0,0,10">
                            <Button x:Name="MeasureButton" Content="Measure" MinWidth="0" Padding="9,3" Click="OnMeasure"
                                    ToolTip="Pitch, jitter, shimmer, HNR, formants, loudness, peak and clipping of the selection"/>
                            <Button x:Name="IdentifyButton" Content="Who is speaking?" MinWidth="0" Padding="9,3" Click="OnIdentify"
                                    ToolTip="Compare the selection's voice with every speaker in this recording and your voice library"/>
                            <Button x:Name="NoteButton" Content="Add note…" MinWidth="0" Padding="9,3" Click="OnAddNote"
                                    ToolTip="Record an observation at this point (time-stamped, signed into the audit log)"/>
                            <Button Content="Clear" MinWidth="0" Padding="9,3" Click="OnClearSelection"/>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Label}" Text="RESULTS"/>
                        <TextBox x:Name="ResultsBox" IsReadOnly="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11" Padding="6,4" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="IntegrityButton" Content="Integrity check" MinWidth="0" Padding="9,3" Click="OnScopeIntegrity"
                                    ToolTip="Whole-file checks: SHA-256, metadata, clipping, digital silence, background steps (possible splices), mains hum (ENF). Findings appear as markers."/>
                            <Button x:Name="ReportButton" Content="Export report…" Style="{StaticResource PrimaryButton}" MinWidth="0" Padding="9,3" Margin="0" Click="OnForensicReport"/>
                        </WrapPanel>

                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Verify chain" MinWidth="0" Padding="8,2" Margin="0" Click="OnVerifyAudit"
                                    ToolTip="Recompute every entry's SHA-256 and link to prove the log has not been altered"/>
                            <TextBlock Style="{StaticResource Label}" Text="AUDIT LOG" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="AuditStatus" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                        <ListBox x:Name="AuditList" Height="220" MouseDoubleClick="OnAuditDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2" ToolTip="{Binding Hash}">
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{DynamicResource Muted}">
                                            <Run Text="{Binding Seq, StringFormat=#{0}, Mode=OneWay}"/> <Run Text="{Binding AtText, Mode=OneWay}"/> · <Run Text="{Binding RangeText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" FontSize="11.5"><Run Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold"/>: <Run Text="{Binding Summary, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="WhisperDesk.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WhisperDesk" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Fg}"
        MouseLeftButtonDown="OnDrag" KeyDown="OnKey">
    <Window.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel>
            <!-- Brand header -->
            <Border Background="{DynamicResource HeaderBg}" CornerRadius="5,5,0,0" Padding="26,22,26,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/logo.png" Width="76" Height="76" Margin="0,0,20,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WhisperDesk" FontFamily="{StaticResource MonoFont}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource HeaderFg}"/>
                            <TextBlock x:Name="VersionText" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Muted}"
                                       Margin="10,0,0,5" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="by darkcipher0x" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Brand}"/>
                            <Border Width="7" Height="13" Margin="6,0,0,0" Background="{DynamicResource Brand}" VerticalAlignment="Center">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.1">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Private, on-device transcription and speaker intelligence." Margin="0,8,0,0"
                                   Foreground="{DynamicResource HeaderFg}" Opacity="0.85" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Height="1" Background="{DynamicResource Accent}" Opacity="0.6"/>

            <StackPanel Margin="26,16,26,20">
                <WrapPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource Accent}"><TextBlock Style="{StaticResource ChipText}" Text="open source · MIT"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}" Text="100% on-device"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}" Text="no cloud · no account · no telemetry"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}" Text="GPU · Vulkan"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}" Text="local AI summaries (Ollama, optional)"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}" Text="built on open-source engines"/></Border>
                </WrapPanel>

                <!-- Splash: loading status -->
                <StackPanel x:Name="SplashPanel" Visibility="Collapsed" Margin="0,6,0,0">
                    <TextBlock x:Name="SplashStatus" Text="Starting…" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Muted}"/>
                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- About: details -->
                <StackPanel x:Name="AboutPanel">
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,10" LineHeight="19">
                        Audio, transcripts, voiceprints and summaries stay on this computer. Nothing is uploaded, and there is no account,
                        telemetry or analytics. The only network use is downloading models you choose and, if you turn it on, talking to an
                        Ollama server at the address you set (by default this PC).
                    </TextBlock>
                    <TextBlock x:Name="CloudWarning" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold" Visibility="Collapsed"
                               Foreground="#E8A33D"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Engine" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Grid.Column="1" x:Name="EngineText" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="Library" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LibraryText" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="2" Text="Models" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ModelsText" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="3" Text="Settings &amp; logs" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DataText" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="4" Text="Components" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Muted}"
                                   Text="whisper.cpp / ggml (MIT) · Whisper.net (MIT) · OpenAI Whisper models (MIT) · sherpa-onnx (Apache-2.0) · pyannote segmentation (MIT) · WeSpeaker ResNet34 voice embeddings (Apache-2.0) · Silero VAD (MIT) · NAudio (MIT) · PDFsharp/MigraDoc (MIT) · FFmpeg (LGPL/GPL, not bundled)"/>
                    </Grid>
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="© 2026 darkcipher0x · Open-source software under the MIT License: free to use, study, change and share. Provided as is, without warranty."/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource PrimaryButton}" Margin="0" IsCancel="True" IsDefault="True" Click="OnClose"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="User guide" Click="OnGuide"/>
                            <Button Content="Privacy &amp; security" Click="OnPrivacy"/>
                            <Button Content="Open data folder" Click="OnDataFolder"/>
                            <Button Content="Licence" Click="OnLicence"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

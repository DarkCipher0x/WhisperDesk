<Window x:Class="WhisperDesk.ModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Models — WhisperDesk" Height="660" Width="880" MinHeight="460" MinWidth="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        SourceInitialized="OnSourceInitialized" Closing="OnClosing">
    <DockPanel Margin="16">
        <!-- Header: what the list is and where it came from -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="CheckButton" Content="Check for new models" Click="OnCheck"
                        ToolTip="Fetches the newest model list WhisperDesk has published (signed with its release keys) from GitHub"/>
                <Button x:Name="UpdateAllButton" Content="Update all" Style="{StaticResource PrimaryButton}" Click="OnUpdateAll" IsEnabled="False"
                        ToolTip="Downloads every update for the models you have"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Speech and speaker models" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="CatalogInfo" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,12,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="OnClose"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Open models folder" Click="OnOpenFolder"/>
                <Button x:Name="CleanButton" Content="Remove old files…" Click="OnClean" IsEnabled="False"
                        ToolTip="Model files no model in the list uses any more (for example after an update renamed one)"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource Muted}"
                   Text="Every model downloads from a pinned Hugging Face revision or GitHub release and must match the list's size and SHA-256 before it is used. Models are data, never programs. The NPU versions of Base, Small and Large-v3 Turbo download by themselves the first time they run on an NPU. Your own model files: Tools → Models → Import a custom model."/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,1">
                            <!-- Group heading -->
                            <TextBlock Text="{Binding Heading}" Margin="0,12,0,4" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}" Visibility="{Binding HeadingVisibility}"/>
                            <!-- A model -->
                            <Border Padding="10,7" CornerRadius="6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" Visibility="{Binding RowVisibility}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding ActionText}" Tag="{Binding}" Click="OnAction" MinWidth="96"
                                                IsEnabled="{Binding ActionEnabled}" Visibility="{Binding ActionVisibility}"/>
                                        <Button Content="Remove" Tag="{Binding}" Click="OnRemove" MinWidth="0"
                                                Visibility="{Binding RemoveVisibility}" ToolTip="Delete this model file (it downloads again when needed)"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{Binding StatusBrush}" Width="190"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0" FontSize="12"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Width="70" VerticalAlignment="Center"
                                               TextAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>

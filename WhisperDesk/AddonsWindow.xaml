<Window x:Class="WhisperDesk.AddonsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add-ons — WhisperDesk" Height="640" Width="860" MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        SourceInitialized="OnSourceInitialized">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Margin="0" IsCancel="True" Click="OnClose"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Open add-ons folder" Click="OnOpenFolder" ToolTip="Put each add-on in its own folder with its addon.json, then restart WhisperDesk"/>
                <Button Content="Developer guide" Click="OnOpenGuide" ToolTip="How to write your own add-on (SDK)"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <!-- Add-on list -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="INSTALLED ADD-ONS"/>
                <ListBox x:Name="AddonList" SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,5">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Click="OnToggle"
                                          VerticalAlignment="Top" Margin="0,2,8,0" ToolTip="Enable / disable"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Details -->
            <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="AddonName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AddonDescription" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,10"/>
                        <TextBlock Style="{StaticResource Label}" Text="PERMISSIONS"/>
                        <TextBlock x:Name="AddonRunsIn" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="AddonPermissions" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="AddonStatus" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="ReviewButton" Content="Review permissions…" Click="OnReview"/>
                            <Button x:Name="RevokeButton" Content="Remove permissions" Click="OnRevoke"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="SaveOptionsButton" Content="Save settings" Style="{StaticResource PrimaryButton}" Click="OnSaveOptions"/>
                        <Button x:Name="OpenPageButton" Content="Open in browser" Click="OnOpenPage" Visibility="Collapsed"/>
                        <Button x:Name="CopyUrlButton" Content="Copy OBS overlay URL" Click="OnCopyUrl" Visibility="Collapsed"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OptionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"/>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                        <TextBlock Text="{Binding Help}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Log -->
            <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="ADD-ON LOG"/>
                <ListBox x:Name="LogList" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

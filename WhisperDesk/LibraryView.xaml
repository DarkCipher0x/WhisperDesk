<UserControl x:Class="WhisperDesk.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WhisperDesk">
    <UserControl.Resources>
        <!-- [+] / [−] expander for the folder tree -->
        <Style x:Key="PlusMinusToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Border x:Name="box" Width="11" Height="11" BorderThickness="1" CornerRadius="2"
                                    BorderBrush="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid>
                                    <Rectangle Width="5" Height="1" Fill="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Rectangle x:Name="vert" Width="1" Height="5" Fill="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="vert" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="bd" Padding="2,3,6,3" CornerRadius="2" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="exp" Style="{StaticResource PlusMinusToggle}" ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="items" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="exp" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="items" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Selection}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Folders -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="FOLDERS"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="+ Folder" MinWidth="0" Padding="9,3" Click="OnNewFolder" ToolTip="New folder inside the selected one"/>
                <Button Content="Rename" MinWidth="0" Padding="9,3" Click="OnRenameFolder"/>
                <Button Content="Delete" MinWidth="0" Padding="9,3" Margin="0" Click="OnDeleteFolder"/>
            </StackPanel>
            <TreeView x:Name="FolderTree" SelectedItemChanged="OnFolderChanged" ItemContainerStyle="{StaticResource FolderItem}"
                      Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="2"
                      AllowDrop="True" Drop="OnFolderDrop" DragOver="OnFolderDragOver"
                      ToolTip="Click + / − to expand or collapse. Drag recordings onto a folder to move them.">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="+ New folder…" Click="OnNewFolder"/>
                        <MenuItem Header="Rename…" Click="OnRenameFolder"/>
                        <MenuItem Header="Delete folder…" Click="OnDeleteFolder"/>
                        <Separator/>
                        <MenuItem Header="Expand all" Click="OnExpandAll"/>
                        <MenuItem Header="Collapse all" Click="OnCollapseAll"/>
                        <Separator/>
                        <MenuItem Header="Re-transcribe everything in this folder…" Click="OnRetranscribeFolder"/>
                        <MenuItem Header="Show in Explorer" Click="OnRevealFolder"/>
                        <MenuItem Header="Reload library" Click="OnRefresh"/>
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Muted}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

        <!-- Recordings -->
        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Padding="6,4" TextChanged="OnFilterChanged"
                         ToolTip="Search titles, tags, notes, speaker names and transcript text"/>
                <TextBlock Text="🔍  Search titles, tags, speakers, transcript text…" IsHitTestVisible="False" Margin="9,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Muted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox Grid.Column="2" x:Name="TypeFilter" SelectionChanged="OnFilterChanged"/>
                <Button Grid.Column="3" Content="↻" MinWidth="0" Padding="9,3" Margin="6,0,0,0" ToolTip="Reload library" Click="OnRefresh"/>
            </Grid>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Delete" Margin="0" Click="OnDelete"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open transcript" Style="{StaticResource PrimaryButton}" Click="OnOpen"/>
                    <Button Content="▶ Player" Click="OnPlay" ToolTip="Listen with the transcript: click any line to jump there"/>
                    <Button Content="Share…" Click="OnShare" ToolTip="Windows share sheet, or save as web player, session package, PDF, Word, text or summary"/>
                    <Button Content="Report…" Click="OnBulkReport" ToolTip="Report / summary across the selected recordings (Ctrl+click to select several)"/>
                    <Button Content="Summary…" Click="OnSummary"/>
                    <Button Content="Re-analyse…" Click="OnReanalyse" ToolTip="Detect the speakers again (optionally against your voice library)"/>
                    <Button Content="Edit details…" Click="OnEdit"/>
                    <Button Content="Show in Explorer" Click="OnReveal"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <ListView x:Name="RecordingList" MouseDoubleClick="OnOpen" SelectionMode="Extended" ContextMenuOpening="OnRecordingMenuOpening"
                          PreviewMouseLeftButtonDown="OnListMouseDown" MouseMove="OnListMouseMove" KeyDown="OnListKeyDown">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="MenuOpen" Header="Open transcript" FontWeight="Bold" Click="OnOpen"/>
                            <MenuItem x:Name="MenuPlay" Header="▶ Open in player" Click="OnPlay"/>
                            <MenuItem x:Name="MenuForensics" Header="∿ Forensics…" Click="OnForensics"
                                      ToolTip="Waveform, spectrogram, pitch, speaker identification and integrity checks with a tamper-evident audit log"/>
                            <MenuItem x:Name="MenuSummary" Header="Summary…" Click="OnSummary"/>
                            <MenuItem x:Name="MenuShare" Header="Share / export…" Click="OnShare"/>
                            <Separator/>
                            <MenuItem x:Name="MenuReport" Header="Report on selected recordings…" Click="OnBulkReport"
                                      ToolTip="One combined or separate reports for several recordings, with an audit trail and optional AI summary"/>
                            <Separator/>
                            <MenuItem x:Name="MenuRetranscribe" Header="Re-transcribe…" Click="OnRetranscribe"
                                      ToolTip="Transcribe the audio again with the current model and settings (the old transcript is kept in a “previous” folder)"/>
                            <MenuItem x:Name="MenuReanalyse" Header="Re-analyse speakers…" Click="OnReanalyse"/>
                            <MenuItem x:Name="MenuEdit" Header="Edit details…" Click="OnEdit"/>
                            <MenuItem x:Name="MoveMenu" Header="Move to folder"/>
                            <MenuItem x:Name="MenuReveal" Header="Show in Explorer" Click="OnReveal"/>
                            <Separator/>
                            <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="OnSelectAll"/>
                            <MenuItem Header="+ New folder…" Click="OnNewFolder"/>
                            <MenuItem x:Name="MenuDelete" Header="Delete…" InputGestureText="Del" Click="OnDelete"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" Width="200" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Type" Width="78" DisplayMemberBinding="{Binding Type}"/>
                            <GridViewColumn Header="Date" Width="118" DisplayMemberBinding="{Binding Created, StringFormat=yyyy-MM-dd HH:mm}"/>
                            <GridViewColumn Header="Length" Width="58" DisplayMemberBinding="{Binding Duration}"/>
                            <GridViewColumn Header="Speakers" Width="140" DisplayMemberBinding="{Binding SpeakerNames}"/>
                            <GridViewColumn Header="Audio" Width="50" DisplayMemberBinding="{Binding MediaText}"/>
                            <GridViewColumn Header="Tags" Width="100" DisplayMemberBinding="{Binding TagText}"/>
                            <GridViewColumn Header="Folder" Width="96" DisplayMemberBinding="{Binding FolderDisplay}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource Muted}"
                           Text="No recordings here yet.&#10;Stop a live session, or use “Save to library” after transcribing a file."/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>

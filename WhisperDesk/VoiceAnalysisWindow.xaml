<Window x:Class="WhisperDesk.VoiceAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Voice &amp; audio analysis — WhisperDesk" Height="800" Width="1180" MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterOwner" Icon="Assets/app.ico"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        SourceInitialized="OnSourceInitialized">
    <DockPanel Margin="16,12,16,12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                   x:Name="DisclaimerText"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ExportButton" Content="Export report…" IsEnabled="False" Click="OnExport"/>
                <Button Content="Close" Margin="0" IsCancel="True" Click="OnClose"/>
            </StackPanel>
            <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Label}" Text="RECORDING"/>
                    <ComboBox x:Name="RecordingBox" SelectionChanged="OnRecordingChanged" MaxDropDownHeight="420"/>
                    <TextBlock x:Name="RecordingInfo" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap"/>

                    <TextBlock Style="{StaticResource Label}" Text="VOICES TO PROFILE"/>
                    <ItemsControl x:Name="SpeakerChecks" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,3">
                                    <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Info, Mode=OneWay}" Foreground="{DynamicResource Muted}"/></TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="ProfileButton" Content="Profile selected voices" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnProfile"
                            ToolTip="Pitch, jitter, shimmer, HNR, formants, speaking rate and loudness for each ticked voice"/>

                    <TextBlock Style="{StaticResource Label}" Text="COMPARE VOICES" Margin="0,18,0,4"/>
                    <TextBlock Text="Voice A" FontSize="12"/>
                    <ComboBox x:Name="CompareA" Margin="0,2,0,6"/>
                    <TextBlock Text="Voice B" FontSize="12"/>
                    <ComboBox x:Name="CompareB" Margin="0,2,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CompareButton" Content="Compare" Click="OnCompare"/>
                        <Button x:Name="CompareAllButton" Content="Compare all voices" Margin="0" Click="OnCompareAll"
                                ToolTip="Every voice in this recording against each other and against your voice library"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Label}" Text="AUDIO INTEGRITY" Margin="0,18,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"
                               Text="SHA-256, container metadata, clipping, digital silence, abrupt background changes (possible splices) and mains-hum (ENF) presence."/>
                    <Button x:Name="IntegrityButton" Content="Check audio integrity" HorizontalAlignment="Left" Click="OnIntegrity"/>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="2">
                <Grid>
                    <wv2:WebView2 x:Name="Preview"/>
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource Muted}"
                               Text="Pick a recording, then profile voices, compare them or check the audio.&#10;Results build up here as a report you can export."/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>

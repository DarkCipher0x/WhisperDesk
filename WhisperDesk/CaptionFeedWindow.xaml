<Window x:Class="WhisperDesk.CaptionFeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live feed — WhisperDesk" Height="720" Width="460" MinWidth="260" MinHeight="200"
        WindowStartupLocation="Manual" Icon="Assets/app.ico" ShowInTaskbar="True"
        FontFamily="Segoe UI" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        SourceInitialized="OnSourceInitialized" KeyDown="OnKey" PreviewMouseWheel="OnWheel" MouseEnter="OnMouseEnterWindow" MouseLeave="OnMouseLeaveWindow">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- One chat line: [time] Name: text — the name in the speaker's colour, the text in the normal colour. -->
        <DataTemplate x:Key="LineWithTime">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontSize="{Binding FeedFontSize, RelativeSource={RelativeSource AncestorType=Window}}">
                <Run Text="{Binding Time, Mode=OneWay, StringFormat='{}{0}  '}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Muted}"
                     FontSize="{Binding FeedTimeSize, RelativeSource={RelativeSource AncestorType=Window}}"/><Run
                     Text="{Binding Speaker.Label, Mode=OneWay, StringFormat='{}{0}:  ', FallbackValue=''}" Foreground="{Binding Speaker.Color, Converter={StaticResource Readable}, FallbackValue=Gray}"
                     FontWeight="SemiBold"/><Run Text="{Binding Text, Mode=OneWay}"/>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="LineNoTime">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontSize="{Binding FeedFontSize, RelativeSource={RelativeSource AncestorType=Window}}">
                <Run Text="{Binding Speaker.Label, Mode=OneWay, StringFormat='{}{0}:  ', FallbackValue=''}" Foreground="{Binding Speaker.Color, Converter={StaticResource Readable}, FallbackValue=Gray}"
                     FontWeight="SemiBold"/><Run Text="{Binding Text, Mode=OneWay}"/>
            </TextBlock>
        </DataTemplate>
        <Style x:Key="FeedItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: shows on hover so the feed stays clean -->
        <Border x:Name="Toolbar" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="◧" ToolTip="Snap to the left edge (Ctrl+Left)" Click="OnSnapLeft"/>
                    <Button Style="{StaticResource ToolButton}" Content="◨" ToolTip="Snap to the right edge (Ctrl+Right)" Click="OnSnapRight"/>
                    <Button Style="{StaticResource ToolButton}" Content="⬓" ToolTip="Snap to the bottom as a caption bar (Ctrl+Down)" Click="OnSnapBottom"/>
                    <Button Style="{StaticResource ToolButton}" Content="⛶" ToolTip="Full screen (F11) · Esc to leave" Click="OnFullScreen"/>
                    <ToggleButton x:Name="PinButton" Content="📌" ToolTip="Always on top" Padding="8,2" Margin="0" MinWidth="0" FontSize="12"
                                  Checked="OnPinChanged" Unchecked="OnPinChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="A−" ToolTip="Smaller text (Ctrl+−, Ctrl+wheel)" Click="OnSmaller"/>
                    <Button Style="{StaticResource ToolButton}" Content="A+" ToolTip="Bigger text (Ctrl++, Ctrl+wheel)" Click="OnBigger"/>
                    <ToggleButton x:Name="TimesButton" Content="🕑" ToolTip="Show times" Padding="8,2" Margin="0,0,4,0" MinWidth="0" FontSize="12"
                                  Checked="OnTimesChanged" Unchecked="OnTimesChanged"/>
                    <TextBlock x:Name="SourceText" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11.5" Foreground="{DynamicResource Muted}"
                               TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ListBox x:Name="Feed" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="12,8,12,12"
                 ItemContainerStyle="{StaticResource FeedItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.ScrollChanged="OnScrollChanged">
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="24" FontSize="14"
                   Text="Waiting for speech…&#10;Start a live session (or open a transcript) and lines appear here."/>

        <Button x:Name="JumpButton" Grid.Row="1" Content="▼  New lines" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,14" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="OnJumpToEnd"/>
    </Grid>
</Window>

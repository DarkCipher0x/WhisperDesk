<Window x:Class="WhisperDesk.EditLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit line — WhisperDesk" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" Icon="Assets/app.ico"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        SourceInitialized="OnSourceInitialized">
    <StackPanel Margin="20,16,20,16">
        <!-- Which line -->
        <DockPanel>
            <Button DockPanel.Dock="Right" x:Name="PlayButton" Content="▶ Play line" MinWidth="0" Margin="0" Padding="10,3" Click="OnPlay"/>
            <TextBlock x:Name="LineHeader" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Style="{StaticResource Label}" Text="ORIGINAL TRANSCRIPTION" Margin="0,14,0,4"/>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="2" Padding="8,6">
            <TextBlock x:Name="OriginalText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
        </Border>

        <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource Label}" Text="PREVIOUS EDITS"/>
            <ItemsControl x:Name="HistoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,4">
                            <StackPanel>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource MonoFont}">
                                    <Run Text="{Binding AtText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding User, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="12"><Run Text="Reason: " FontWeight="SemiBold"/><Run Text="{Binding Reason, Mode=OneWay}"/></TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}"><Run Text="→ "/><Run Text="{Binding NewText, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock Style="{StaticResource Label}" Text="CORRECTED TEXT" Margin="0,14,0,4"/>
        <TextBox x:Name="NewTextBox" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="False" Padding="6,4" TextChanged="OnChanged"/>

        <TextBlock Style="{StaticResource Label}" Text="REASON FOR THIS EDIT (REQUIRED)" Margin="0,14,0,4"/>
        <TextBox x:Name="ReasonBox" MinHeight="58" TextWrapping="Wrap" AcceptsReturn="True" Padding="6,4" TextChanged="OnChanged"
                 VerticalScrollBarVisibility="Auto"/>
        <TextBlock x:Name="ReasonHint" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="e.g. “Misheard name — speaker said Kristoffer, confirmed by playback”."/>

        <Border Margin="0,14,0,0" Padding="8,6" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource Accent}">
            <TextBlock x:Name="AuditText" TextWrapping="Wrap" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="ConfirmButton" Content="Confirm edit" Style="{StaticResource PrimaryButton}" Margin="0" IsEnabled="False" Click="OnConfirm"/>
        </StackPanel>
    </StackPanel>
</Window>
